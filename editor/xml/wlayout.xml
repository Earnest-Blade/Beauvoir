<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="4.0" />
    <object class="GtkFixed" id="wlayout">
        <child>
            <object class="GtkPaned" id="Button">
                <property name="orientation">horizontal</property>
                <property name="width-request">800</property>
                <property name="height-request">800</property>
                <child>
                    <object class="GtkBox" id="wviewport">
                        <property name="orientation">vertical</property>
                        <property name="width-request">400</property>
                        <style>
                            <class name="sidebar"/>
                        </style>
                        <child>
                            <object class="GtkLabel">
                                <property name="label">Viewport</property>
                            </object>
                        </child>
                    </object>
                </child>

                <child>
                    <object class="GtkBox" id="rlayout">
                        <property name="orientation">vertical</property>
                        <style>
                            <class name="sidebar"/>
                        </style>
                        <child>
                            <object class="GtkLabel">
                                <property name="label">Right</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
    </object>
</interface>